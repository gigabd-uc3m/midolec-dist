# Generated outputs
/*.json
midolec-v6/*.json
*.log
*.tmp
__pycache__/
*.pyc

# Local executable packages and build artifacts
bin/
dist/
build/
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.xz

# PyInstaller runtime archive required by the embedded Python interpreter.
# Do not ignore this file: without it the binary fails before Midolec starts
# with "ModuleNotFoundError: No module named 'encodings'".
!midolec-v6/_internal/base_library.zip

# Runtime assets installed by provisioning scripts
runtime/freeling/lib/
runtime/freeling/share/freeling/common/
runtime/freeling/share/freeling/es/
runtime/spacy/models/
midolec-v6/runtime/freeling/lib/
midolec-v6/runtime/freeling/share/freeling/common/
midolec-v6/runtime/freeling/share/freeling/es/
midolec-v6/runtime/spacy/models/

# Local environment files
.env
runtime/provisioning/runtime_sources.env
midolec-v6/runtime/provisioning/runtime_sources.env

# Agent analizers instructions
AGENTS.md
**/AGENTS.md
