# Example source configuration for Midolec v6 runtime provisioning.
#
# Private GitHub Release defaults. Users must authenticate first with:
#   gh auth login
export MIDOLEC_RUNTIME_GITHUB_REPO="gigabd-uc3m/midolec-dist"
export MIDOLEC_RUNTIME_RELEASE_TAG="v6-runtime-2026-05-07"
export MIDOLEC_RUNTIME_RELEASE_URL="https://github.com/gigabd-uc3m/midolec-dist/releases/tag/v6-runtime-2026-05-07"
export MIDOLEC_FREELING_LIBS_ASSET="midolec-v6-freeling-libs-linux-x86_64-2026-05-07.tar.gz"
export MIDOLEC_FREELING_RESOURCES_ASSET="midolec-v6-freeling-resources-es-2026-05-07.tar.gz"

# Optional direct-download endpoints. Leave empty when using the private
# GitHub Release defaults above. Google Drive links only work reliably if they
# are real direct-download URLs.

# Archive containing libfreeling.so, libfoma.so, libtreeler.so, libdynet.so,
# and libcrfsuite.so. Supported formats: .tar, .tar.gz, .tgz, .tar.xz, .zip.
export MIDOLEC_FREELING_LIBS_URL=""

# Archive containing FreeLing common/ and es/ resource folders. The archive may
# contain common/ and es/ at the root, freeling/common and freeling/es, or
# share/freeling/common and share/freeling/es.
export MIDOLEC_FREELING_RESOURCES_URL=""

# Optional Python executable used by the spaCy installer.
export MIDOLEC_PYTHON="python3"
